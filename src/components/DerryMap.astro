---
// Original schematic mini-map of Derry for one cycle (no official art, not to scale): the Kenduskeag winding through
// downtown into the Penobscot, the canal, a block grid, the western woods, a quarry and Juniper Hill. Each numbered
// point links to its entry in the list beside it, so it works without JS (jump + :target) and by keyboard.
// With JS, a point selects its entry in place instead of jumping; hovering or focusing an entry lights its point.
import { ui, type Locale } from '../i18n/ui';
import type { Place } from '../data/places';
import { inNoteOrder } from '../data/citations';
import Note from './Note.astro';

// Era transition (S1): the map can name the era it comes from. Statically it always shows its own era; with motion,
// the home script sets data-era to the previous era and back, so overlays crossfade, the previous era's pins fade out
// as decorative ghosts, and places that keep their position (class `keep`) stay put while the others pop in.
interface Props { locale: Locale; cycleId: string; year: string; places: Place[]; from?: { id: string; places: Place[] } }
const { locale, cycleId, year, places, from } = Astro.props;
const t = ui[locale].home;
const anchor = (place: Place) => `place-${cycleId}-${place.id}`;
const notesOf = (place: Place) => inNoteOrder(place.sourceIds);
const sameSpot = (a: Place, b: Place) => a.x === b.x && a.y === b.y;
const previous = from?.places ?? [];
const kept = (place: Place) => previous.some((p) => sameSpot(p, place));
const ghosts = previous.map((p, i) => ({ ...p, n: i + 1 })).filter((p) => !places.some((own) => sameSpot(own, p)));
const eras = [...new Set([from?.id, cycleId])].filter((id): id is string => ['1962', '1988', '2016'].includes(id ?? ''));
// 1962 overlay: thirteen pillars ringing the western woods.
const pillars = Array.from({ length: 13 }, (_, i) => {
  const a = (i / 13) * Math.PI * 2;
  return { x: (44.5 + Math.cos(a) * 39.5 - 1.5).toFixed(1), y: (104 + Math.sin(a) * 40 - 3).toFixed(1) };
});
const canalBulbs = Array.from({ length: 12 }, (_, i) => 150 + i * 5);
const fairBulbs = Array.from({ length: 10 }, (_, i) => {
  const a = (i / 10) * Math.PI * 2;
  return { x: (236 + Math.cos(a) * 14).toFixed(1), y: (104 + Math.sin(a) * 14).toFixed(1) };
});

const kenduskeag = 'M92 0C104 28 82 50 112 68C136 82 128 104 146 116L150 120';
const canal = 'M150 120H206';
const outflow = 'M206 120C232 120 246 148 296 140';
const penobscot = 'M296 0C288 50 304 96 292 142C284 176 300 200 294 220H320V0Z';
const blocks = [
  [140, 82], [156, 82], [180, 82], [196, 82],
  [134, 98], [184, 98], [200, 98],
  [162, 128], [178, 128], [194, 128], [210, 128],
  [162, 142], [178, 142], [194, 142],
];
const trees = [
  [22, 84, 7], [34, 76, 6], [30, 94, 8], [46, 88, 6], [18, 108, 6], [36, 116, 7],
  [60, 98, 5], [62, 124, 6], [26, 132, 7], [46, 138, 6], [74, 112, 5], [52, 70, 5],
];
---
<div class="map-layout">
  <figure class="map" data-map>
    <svg viewBox="0 0 320 220" role="group" aria-label={`${t.mapLabel}, ${year}`} data-era={cycleId} data-era-from={from?.id ?? 'none'}>
      <g aria-hidden="true">
        <rect width="320" height="220" rx="6" class="land" />
        <path d={penobscot} class="river-wide" />
        <g class="hill">
          <ellipse cx="232" cy="38" rx="44" ry="22" />
          <ellipse cx="232" cy="38" rx="30" ry="14" />
          <ellipse cx="232" cy="38" rx="16" ry="7" />
        </g>
        <g class="woods">
          {trees.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
        </g>
        <g class="quarry">
          <path d="M44 178C52 164 82 162 94 174C104 186 92 204 70 204C50 204 38 192 44 178Z" />
          <path d="M56 180C62 172 80 172 86 180C90 188 82 196 70 196C60 196 52 190 56 180Z" />
        </g>
        <g class="blocks">
          {blocks.map(([x, y]) => <rect x={x} y={y} width="12" height="10" rx="1" />)}
        </g>
        <g class="runway">
          <rect x="176" y="196" width="88" height="6" rx="1" transform="rotate(-8 220 199)" />
        </g>
        <path d={kenduskeag} class="stream" />
        <path d={canal} class="canal" />
        <path d={outflow} class="stream" />
        {eras.includes('1962') && (
          <g class="overlay" data-for="1962">
            <path d={penobscot} class="ov-ice" />
            <path d="M300 30L310 44L304 60M298 96L312 104M296 160L308 176" class="ov-crack" />
            {pillars.map((p) => <rect x={p.x} y={p.y} width="3" height="6" class="ov-pillar" />)}
            <g class="ov-snow">
              <circle cx="120" cy="20" r="0.9" /><circle cx="180" cy="40" r="0.9" /><circle cx="260" cy="90" r="0.9" /><circle cx="100" cy="150" r="0.9" />
              <circle cx="220" cy="170" r="0.9" /><circle cx="150" cy="60" r="0.9" /><circle cx="30" cy="40" r="0.9" /><circle cx="280" cy="200" r="0.9" />
            </g>
          </g>
        )}
        {eras.includes('1988') && (
          <g class="overlay" data-for="1988">
            <g class="ov-leaves">{trees.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={(r * 0.7).toFixed(1)} />)}</g>
            <path d="M56 180C62 172 80 172 86 180C90 188 82 196 70 196C60 196 52 190 56 180Z" class="ov-pool" />
            <path d="M122 134C150 150 200 150 240 152M126 178C160 170 200 160 240 152" class="ov-route" />
          </g>
        )}
        {eras.includes('2016') && (
          <g class="overlay" data-for="2016">
            <g class="ov-bulbs">
              {canalBulbs.map((x) => <circle cx={x} cy="117" r="1.1" />)}
              {fairBulbs.map((b) => <circle cx={b.x} cy={b.y} r="1.1" />)}
            </g>
            <circle cx="236" cy="104" r="14" class="ov-fair" />
          </g>
        )}
        {from && ghosts.length > 0 && (
          <g class="ghost" data-for={from.id}>
            {ghosts.map((p) => (
              <g>
                <circle class="pin" cx={p.x} cy={p.y} r="7.5" />
                <text class="num" x={p.x} y={p.y}>{p.n}</text>
              </g>
            ))}
          </g>
        )}
        <text x="70" y="40" class="label" transform="rotate(-62 70 40)">Kenduskeag</text>
        <text x="306" y="64" class="label" transform="rotate(90 306 64)">Penobscot</text>
      </g>
      {places.map((place, i) => (
        <a class:list={['point', kept(place) && 'keep']} data-point href={`#${anchor(place)}`} aria-label={`${i + 1}. ${place.name[locale]}`}>
          <circle class="ring" cx={place.x} cy={place.y} r="11" />
          <circle class="pin" cx={place.x} cy={place.y} r="7.5" />
          <text class="num" x={place.x} y={place.y} aria-hidden="true">{i + 1}</text>
        </a>
      ))}
    </svg>
    <figcaption>{t.mapCaption}</figcaption>
  </figure>
  <ol class="place-list" aria-label={`${t.placesListLabel}, ${year}`}>
    {places.map((place, i) => (
      <li id={anchor(place)} tabindex="-1" data-place>
        <span class="place-num" aria-hidden="true">{i + 1}</span>
        <div>
          <strong class="place-name">{place.name[locale]}</strong>
          <p class="place-desc">
            {place.description[locale]}
            {notesOf(place).map((id) => <Note locale={locale} source={id} />)}
          </p>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  // Progressive enhancement only: the links already work as plain in-page anchors without this.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.map-layout').forEach((layout) => {
    const points = [...layout.querySelectorAll<SVGAElement>('[data-point]')];
    const itemOf = (point: SVGAElement) => document.getElementById((point.getAttribute('href') ?? '').slice(1));
    const clearActive = () => layout.querySelectorAll('[data-active]').forEach((el) => el.removeAttribute('data-active'));

    for (const point of points) {
      const item = itemOf(point);
      if (!item) continue;
      // Enter on a focused SVG link fires click too, so one handler covers mouse and keyboard.
      point.addEventListener('click', (event) => {
        event.preventDefault();
        clearActive();
        point.setAttribute('data-active', '');
        item.setAttribute('data-active', '');
        item.scrollIntoView({ block: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
        item.focus({ preventScroll: true });
      });
      const on = () => point.setAttribute('data-highlight', '');
      const off = () => point.removeAttribute('data-highlight');
      item.addEventListener('mouseenter', on);
      item.addEventListener('mouseleave', off);
      item.addEventListener('focusin', on);
      item.addEventListener('focusout', off);
    }
  });
</script>

<style>
  .map-layout { display: grid; gap: 1.25rem; margin-top: 0.75rem; }
  @media (min-width: 48rem) {
    .map-layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; }
  }

  .map { margin: 0; }
  .map svg { width: 100%; height: auto; border: 1px solid var(--color-overlay); border-radius: 0.375rem; }
  .map figcaption { margin-top: 0.5rem; font: 0.8125rem/1.4 var(--font-mono); color: var(--color-comment); }

  .land { fill: #0b121b; }
  .river-wide { fill: #16263a; }
  .stream { fill: none; stroke: #2b4562; stroke-width: 4; stroke-linecap: round; }
  .canal { fill: none; stroke: #2b4562; stroke-width: 5; }
  .hill ellipse { fill: none; stroke: #22303f; stroke-width: 1; }
  .woods circle { fill: #15241f; stroke: #1f3329; stroke-width: 1; }
  .quarry path { fill: none; stroke: #33404f; stroke-width: 1.2; stroke-dasharray: 3 2; }
  .blocks rect { fill: #141e2c; stroke: #22303f; stroke-width: 0.8; }
  .runway rect { fill: #141e2c; stroke: #33404f; stroke-width: 0.8; }
  .label { font: italic 7px var(--font-mono); fill: #8b9bb0; letter-spacing: 0.08em; }

  .point { cursor: pointer; outline: none; }
  .pin { fill: var(--color-err); stroke: var(--color-ink); stroke-width: 1.5; }
  .num { font: 700 8px var(--font-mono); fill: var(--color-ink); text-anchor: middle; dominant-baseline: central; pointer-events: none; }
  .ring { fill: none; stroke: var(--color-text); stroke-width: 2; opacity: 0; }
  .point:hover .ring,
  .point[data-highlight] .ring { opacity: 0.6; }
  .point[data-active] .ring { opacity: 1; stroke: var(--color-err); }
  /* Keyboard focus ring always wins and stays visible on every background. */
  .point:focus-visible .ring { opacity: 1; stroke: var(--color-text); stroke-width: 2.5; }

  .place-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .place-list li { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.625rem; padding: 0.5rem 0.625rem; border: 1px solid transparent; border-radius: 0.375rem; scroll-margin-block: 1rem; }
  .place-list li:target,
  .place-list li[data-active] { border-color: var(--color-err); background: var(--color-surface); }
  .place-list li:focus-visible { outline: 2px solid var(--color-err); outline-offset: 2px; }
  .place-num { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 9999px; background: var(--color-err); color: var(--color-ink); font: 700 0.75rem/1 var(--font-mono); }
  .place-name { display: block; font: 600 0.9375rem/1.4 var(--font-sans); color: var(--color-text); }
  .place-desc { margin: 0.125rem 0 0; font-size: 0.9375rem; color: var(--color-subtext); }

  /* Era overlays and the previous era's ghost pins follow the svg's data-era (decorative, aria-hidden). */
  .overlay, .ghost { opacity: 0; visibility: hidden; }
  svg[data-era='1962'] [data-for='1962'],
  svg[data-era='1988'] [data-for='1988'],
  svg[data-era='2016'] [data-for='2016'] { opacity: 1; visibility: visible; }
  .ghost .pin { fill: var(--color-comment); }
  .ov-ice { fill: var(--era-1962-crack); opacity: 0.28; }
  .ov-crack { fill: none; stroke: var(--color-text); stroke-opacity: 0.5; stroke-width: 0.8; }
  .ov-pillar { fill: var(--color-subtext); }
  .ov-snow { fill: var(--color-text); opacity: 0.5; }
  .ov-leaves { fill: var(--map-1988-woods); opacity: 0.8; }
  .ov-pool { fill: #2b4562; }
  .ov-route { fill: none; stroke: var(--era-1988-sun); stroke-opacity: 0.7; stroke-width: 1; stroke-dasharray: 2 3; }
  .ov-bulbs { fill: var(--era-2016-bulb); }
  .ov-fair { fill: none; stroke: var(--era-2016-bulb); stroke-opacity: 0.4; }

  @media (prefers-reduced-motion: no-preference) {
    .overlay, .ghost { transition: opacity 0.7s ease, visibility 0s linear 0.7s; }
    svg[data-era='1962'] [data-for='1962'],
    svg[data-era='1988'] [data-for='1988'],
    svg[data-era='2016'] [data-for='2016'] { transition: opacity 0.7s ease, visibility 0s; }
    .point { transform-box: fill-box; transform-origin: 50% 50%; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1.4), opacity 0.4s ease; }
    /* While a map still shows the era it comes from, its own new pins wait small; kept places never move. */
    svg[data-era='none'][data-era-from='none'] .point:not(.keep),
    svg[data-era='1962'][data-era-from='1962'] .point:not(.keep),
    svg[data-era='1988'][data-era-from='1988'] .point:not(.keep) { transform: scale(0.2); opacity: 0; }
    .ring { transition: opacity 0.2s ease, stroke 0.2s ease; }
    .place-list li { transition: background-color 0.2s ease, border-color 0.2s ease; }
  }
</style>
