---
// Upcoming eras (1908, 1935) — kept deliberately simple: Derry drawn hollow, in dashed outline, still waiting to be
// told, with a little fog. One shared original illustration; `seed` only varies the stars.
import { scatter, skyline, waterTower } from './art';

interface Props { seed: number }
const { seed } = Astro.props;
const stars = scatter(seed, 18, { x: [0, 1600], y: [10, 220], r: [0.7, 1.4] });
---
<svg class="art" data-era-art="upcoming" viewBox="0 0 1600 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <rect width="1600" height="420" fill="#070b10" />
  <g class="a-twinkle" fill="#8b9bb0" opacity="0.6">
    {stars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} style={`--d:${s.d}`} />)}
  </g>
  <g transform="translate(0 -4) scale(4)" fill="none" stroke="#ff5c7a" stroke-opacity="0.45" stroke-width="0.4" stroke-dasharray="2 1.5">
    <path d={skyline} /><path d={waterTower} />
  </g>
  <path d="M0 380H1600" stroke="#22303f" stroke-width="2" />
  <g class="a-fog" fill="#8b9bb0" opacity="0.06"><rect x="-100" y="330" width="900" height="50" rx="25" /><rect x="900" y="350" width="800" height="40" rx="20" /></g>
</svg>
