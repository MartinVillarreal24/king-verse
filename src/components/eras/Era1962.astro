---
// 1962 — winter at the air base (original art). Searchlights, a bomber silhouette, quonset huts and the control tower
// over the frozen Penobscot, where small figures follow a red balloon toward the gnarled tree. No clown, no faces.
// Layers marked data-depth drift on scroll (parallax) when motion is allowed; ambient loops arm with .kv-motion.
import { scatter, treeline } from './art';

const stars = scatter(1962, 40, { x: [0, 1600], y: [10, 300], r: [0.7, 1.6] });
const snow = scatter(6219, 60, { x: [0, 1600], y: [0, 900], r: [1, 2.6] });
const ridgeTrees = treeline(62, 700, 1640, 560, [26, 58]);
const fencePosts = Array.from({ length: 30 }, (_, i) => i * 24);
const runwayLights = Array.from({ length: 14 }, (_, i) => 80 + i * 46);
const walkers = [[760, 668, 1], [800, 664, 0.95], [842, 660, 0.9], [880, 656, 0.86], [916, 652, 0.82], [948, 648, 0.78]];
const walker = 'M-3 0L-2 -10L-4 -10L-4 -20Q0 -23 4 -20L4 -10L2 -10L3 0Z';
const huts = ['M120 560V532A62 44 0 0 1 244 532V560Z', 'M262 560V530A66 46 0 0 1 394 530V560Z', 'M412 560V534A58 40 0 0 1 528 534V560Z'];
---
<svg class="art" data-era-art="1962" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="e62-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="st-ink" /><stop offset="0.45" class="st-mid" /><stop offset="0.82" class="st-fog" /><stop offset="1" class="st-horizon" />
    </linearGradient>
    <linearGradient id="e62-ice" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="st-ice" /><stop offset="0.35" class="st-fog" /><stop offset="1" class="st-night" />
    </linearGradient>
    <linearGradient id="e62-beam" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#e6edf3" stop-opacity="0.16" /><stop offset="1" stop-color="#e6edf3" stop-opacity="0" />
    </linearGradient>
    <filter id="e62-blur"><feGaussianBlur stdDeviation="22" /></filter>
  </defs>
  <rect width="1600" height="900" fill="url(#e62-sky)" />
  <g data-depth="0.04" class="a-twinkle" fill="#8b9bb0">
    {stars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} style={`--d:${s.d}`} />)}
  </g>
  <g data-depth="0.08">
    <g class="a-beam" style="transform-origin:575px 455px"><path d="M575 455L470 -40L560 -40Z" fill="url(#e62-beam)" /></g>
    <g class="a-beam" style="transform-origin:300px 520px;animation-delay:-4s"><path d="M300 520L240 -40L300 -40Z" fill="url(#e62-beam)" opacity="0.7" /></g>
  </g>
  <g data-depth="0.1">
    <g class="a-drift">
      <g transform="translate(980 200) scale(1.25) rotate(-6)" class="f-deep">
        <path d="M-104 -4L92 -4Q106 0 92 4L-104 4Z" />
        <path d="M24 -3L-38 -98L-50 -98L-12 -3Z" /><path d="M24 3L-38 98L-50 98L-12 3Z" />
        <path d="M-82 -3L-102 -32L-110 -32L-100 -3Z" /><path d="M-82 3L-102 32L-110 32L-100 3Z" />
        <ellipse cx="10" cy="-30" rx="10" ry="3.6" /><ellipse cx="-8" cy="-58" rx="10" ry="3.6" />
        <ellipse cx="10" cy="30" rx="10" ry="3.6" /><ellipse cx="-8" cy="58" rx="10" ry="3.6" />
      </g>
    </g>
  </g>
  <g data-depth="0.15">
    <path d="M0 520C200 486 380 506 560 478C760 446 900 494 1100 472C1300 452 1450 492 1600 470V560H0Z" class="f-ridge" />
    <path d={ridgeTrees} class="f-ridge-deep" />
  </g>
  <g data-depth="0.25" class="f-silhouette">
    {huts.map((d) => <path d={d} />)}
    <rect x="566" y="470" width="18" height="90" /><rect x="552" y="448" width="46" height="24" /><path d="M548 448H602L592 436H558Z" />
    <rect x="558" y="454" width="34" height="10" class="f-window" opacity="0.55" />
    <g class="s-silhouette" stroke-width="2">
      <path d="M0 548H700M0 538H700" />
      {fencePosts.map((x) => <path d={`M${x} 528V560`} />)}
    </g>
    <g class="f-window" opacity="0.8">{runwayLights.map((x) => <circle cx={x} cy="566" r="2" />)}</g>
  </g>
  <rect y="560" width="1600" height="340" fill="url(#e62-ice)" />
  <g opacity="0.25" class="f-silhouette" transform="matrix(1 0 0 -0.5 0 840)">{huts.map((d) => <path d={d} />)}</g>
  <g data-depth="0.35" fill="none" class="s-crack" stroke-opacity="0.28" stroke-width="1.4">
    <path d="M120 640L260 660L330 652L470 690M330 652L360 620M700 610L820 640L900 630L1020 668M820 640L800 700L860 760M200 760L380 740L520 790L640 780M1100 720L1260 700L1400 740M1260 700L1280 650" />
  </g>
  <g data-depth="0.4" class="f-deep">
    {walkers.map(([x, y, s]) => <g transform={`translate(${x} ${y}) scale(${s})`}><path d={walker} /><circle cy="-26" r="4.2" /></g>)}
    <g class="a-bob">
      <path d="M1010 640C1007 628 1013 620 1009 608" stroke="#c9d3df" stroke-opacity="0.5" fill="none" />
      <ellipse cx="1009" cy="598" rx="7" ry="9" fill="#ff5c7a" />
    </g>
  </g>
  <g class="a-fog" filter="url(#e62-blur)" fill="#b3c0cf" opacity="0.12">
    <rect x="-200" y="500" width="1100" height="90" rx="45" /><rect x="800" y="600" width="1000" height="70" rx="35" />
  </g>
  <g class="a-fog2" filter="url(#e62-blur)" fill="#b3c0cf" opacity="0.08"><rect x="200" y="700" width="1200" height="110" rx="55" /></g>
  <g data-depth="0.7" fill="none" stroke="#04070b" stroke-linecap="round">
    <path d="M1420 960C1398 860 1452 790 1412 716C1382 660 1432 610 1402 544" stroke-width="36" />
    <path d="M1406 618C1352 588 1322 528 1262 506" stroke-width="13" /><path d="M1412 668C1480 638 1520 590 1582 576" stroke-width="15" />
    <path d="M1402 548C1392 492 1422 452 1402 402" stroke-width="9" /><path d="M1262 506C1240 476 1250 446 1220 424" stroke-width="5" />
    <path d="M1582 576C1604 546 1624 526 1650 524" stroke-width="6" /><path d="M1402 402C1382 382 1362 382 1340 360" stroke-width="4" />
    <path d="M1402 432C1432 412 1452 384 1472 372" stroke-width="4" /><path d="M1302 526C1302 500 1286 484 1292 462" stroke-width="4" />
  </g>
  <g data-depth="0.8">
    <path d="M0 900V826C200 796 400 836 600 816C800 796 1000 846 1200 826C1350 810 1500 836 1600 820V900Z" fill="#0b121b" stroke="#8b9bb0" stroke-opacity="0.35" stroke-width="2" />
  </g>
  <g class="a-snow" fill="#e6edf3" opacity="0.7">
    {snow.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} style={`--d:${s.d}`} />)}
  </g>
</svg>

<style>
  .st-ink { stop-color: var(--color-ink); }
  .st-night { stop-color: var(--color-night); }
  .st-mid { stop-color: var(--era-1962-sky-mid); }
  .st-fog { stop-color: var(--era-1962-fog); }
  .st-horizon { stop-color: var(--era-1962-horizon); }
  .st-ice { stop-color: var(--era-1962-ice); }
  .f-ridge { fill: var(--era-1962-ridge); }
  .f-ridge-deep { fill: var(--era-1962-ridge-deep); }
  .f-silhouette { fill: var(--era-1962-silhouette); }
  .s-silhouette { stroke: var(--era-1962-silhouette); }
  .f-deep { fill: var(--era-1962-silhouette-deep); }
  .f-window { fill: var(--era-1962-window); }
  .s-crack { stroke: var(--era-1962-crack); }
</style>
